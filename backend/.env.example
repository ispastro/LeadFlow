# =============================================================================
# LeadFlow RevOps Engine — Environment Variables
# Copy to .env and fill in every REQUIRED value.
# =============================================================================

# --- Database (REQUIRED) -----------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/leadflow

# --- AI services (REQUIRED) --------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# --- Auth (REQUIRED) ---------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_use_a_random_32plus_char_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_strong_password

# --- LangSmith Observability (OPTIONAL but recommended) ----------------------
# Get your key at: https://smith.langchain.com
LANGCHAIN_API_KEY=ls__your_langsmith_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=leadflow-revops
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- Server ------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development   # development | staging | production

# --- CORS --------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Email notifications (OPTIONAL) -----------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com
NOTIFICATION_EMAILS=

# --- Dashboard URL (used in email links) -------------------------------------
DASHBOARD_URL=http://localhost:3001

# --- Rate limiting -----------------------------------------------------------
CHAT_RATE_LIMIT_PER_MINUTE=30

# --- RevOps HITL settings ----------------------------------------------------
# Qualification score (0-100) above which human approval is required
HITL_SCORE_THRESHOLD=90
# Seconds to wait for approval before routing to manual review (0 = indefinite)
HITL_TIMEOUT_SECONDS=0
